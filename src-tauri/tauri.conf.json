{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDock",
  "version": "1.0.0",
  "identifier": "local.agentdock.app",
  "mainBinaryName": "agentdock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentDock",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "WorkBuddy · Qoder · Trae 统一工作台与模型网关",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
