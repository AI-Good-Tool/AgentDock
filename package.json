{
  "name": "agentdock",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test:core": "cargo test --workspace --manifest-path src-tauri/Cargo.toml",
    "test:display": "node --test src/lib/account-display.test.mjs",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
